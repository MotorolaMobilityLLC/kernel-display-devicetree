		qcom,mdss-dsi-dfps-60-command-state = "dsi_hs_mode";

		qcom,mdss-dsi-dfps-90-command = [39 00 00 00 00 00 02 6c 02];
		qcom,mdss-dsi-dfps-90-command-state = "dsi_hs_mode";

