		qcom,mdss-dsi-h-right-border = <0>;
		qcom,mdss-dsi-v-top-border = <0>;
		qcom,mdss-dsi-v-bottom-border = <0>;
		qcom,vid-on-commands = [
			39 00 00 00 00 00 03 F0 AA 10
			39 00 00 00 00 00 14 D0 84 68 22 22 84 0F 0C 0C 55 55 10 00 05 0C 0C 55 55 10 00
			39 00 00 00 00 00 16 D1 00 39 2A 2A 2A 2A 0B 00 00 19 00 00 00 00 38 0B 19 00 00 00 00
			39 00 00 00 00 00 02 03 01
			39 00 00 00 00 00 02 35 00
			39 00 00 00 00 00 03 51 00 00
			39 00 00 00 00 00 02 53 20
			39 00 00 00 00 00 02 59 09
			39 00 00 00 00 00 02 5E 00
			39 00 00 00 00 00 02 6C 03
			39 00 00 00 00 00 02 6D 00
			39 00 00 00 00 00 02 6F 01
			39 00 00 00 00 00 02 72 00
			39 00 00 00 00 00 03 F0 AA 16
			39 00 00 00 00 00 11 D1 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			39 00 00 00 00 00 03 FF 5A 80
			39 00 00 00 00 00 02 65 25
			39 00 00 00 00 00 02 fd 01
			39 00 00 00 00 00 03 FF 5A 81
			39 00 00 00 00 00 02 65 03
			39 00 00 00 00 00 02 F3 61
			39 00 00 00 00 00 02 65 0B
			39 00 00 00 00 00 02 F3 78
			05 00 00 00 78 00 01 11
			05 00 00 00 00 00 01 29];	/* display on */
		qcom,cmd-on-commands = [
			39 00 00 00 00 00 03 F0 AA 10
			39 00 00 00 00 00 14 D0 84 68 22 22 84 0F 0C 0C 55 55 10 00 05 0C 0C 55 55 10 00
			39 00 00 00 00 00 16 D1 00 39 2A 2A 2A 2A 0B 00 00 19 00 00 00 00 38 0B 19 00 00 00 00
			39 00 00 00 00 00 02 03 01
			39 00 00 00 00 00 02 35 00
			39 00 00 00 00 00 03 51 00 00
			39 00 00 00 00 00 02 53 20
			39 00 00 00 00 00 02 59 09
			39 00 00 00 00 00 02 5E 00
			39 00 00 00 00 00 02 6C 03
			39 00 00 00 00 00 02 6D 00
			39 00 00 00 00 00 02 6F 01
			39 00 00 00 00 00 02 72 00
			39 00 00 00 00 00 03 F0 AA 16
			39 00 00 00 00 00 11 D1 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			39 00 00 00 00 00 03 FF 5A 80
			39 00 00 00 00 00 02 65 25
			39 00 00 00 00 00 02 fd 01
			39 00 00 00 00 00 03 FF 5A 81
			39 00 00 00 00 00 02 65 03
			39 00 00 00 00 00 02 F3 61
			39 00 00 00 00 00 02 65 0B
			39 00 00 00 00 00 02 F3 78
			05 00 00 00 78 00 01 11
			05 00 00 00 00 00 01 29

			//cmd aod mode
			39 00 00 40 00 00 01 28
			39 00 00 40 00 00 02 6F 02
			39 00 00 40 00 00 02 6D 00
			39 00 00 00 11 00 01 39
			05 00 00 00 00 00 01 29];	/* display on */
		qcom,mdss-dsi-off-command = [
			05 01 00 00 00 00 01 28		/* display_off */
			05 00 00 00 64 00 01 10];	/* enter sleep mode */

		qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
		qcom,mdss-dsi-off-command-state = "dsi_lp_mode";
		qcom,mdss-dsi-timing-switch-command-state =
			"dsi_hs_mode";
		qcom,compression-mode = "dsc";
		/* Why QCOM doesn't use this, even it used 2 encoder
		 * as for that dsi_sw43404_amoled_cmd, for ex */
		/* qcom,mdss-dsc-encoders = <2>; */
