&qupv3_se2_i2c {
	status = "ok";

        lcd_backlight@36 {
                compatible = "awinic,aw99703-bl", "ktd,ktd3136";
                reg = <0x36>;

		/* Awinic, aw99703 */
                aw99703,hwen-gpio = <&pm6150l_gpios 10 0>;
                aw99703,bl-map = <3>; /* brightness map level 1:256,2:1024,3:2048 */
                aw99703,using-lsb;
                aw99703,ovp-level = <3>; /* 0:17.5V, 1:24V, 2:31V, 3:38V, 4:41.5V */
                aw99703,ocp-level = <2>; /* 0:0.9A, 1:1.8A, 2:2.7A, 3:3.4A */
                aw99703,switch-freq = <1>; /* 1000kHz(default) */
                aw99703,auto-freq-high = <0x10>;
                aw99703,auto-freq-low = <0x05>;
                aw99703,bl-fscal-led = <0x1E>; /* 28.8mA */
                aw99703,bl-channel = <3>; /* 3 led string */
                aw99703,turn-on-ramp = <0x00>; /* 512us */
                aw99703,turn-off-ramp = <0x04>; /* 8ms */
                aw99703,pwm-trans-dim = <0>; /* 2ms */
                aw99703,i2c-trans-dim = <1>; /* 128ms */
                aw99703,skip-first-trans;
                aw99703,reset-trans-delay;
                aw99703,pwm-mode = <1>; /* 1 pwm enable,0 PWM disable */
                aw99703,map-type = <0>; /* 0 exponential, 4 linear */
		current-align-type = <0x03>; /* 0-none,  1-450nit,  2-1000nit,  3-gamma1.5 1000nit */
                aw99703,work-mode = <1>; /* backlight */
		aw99703,default-brightness = <1251>;

		/* ktd3136*/
		ktd,hwen-gpio = <&pm6150l_gpios 10 0>;
                ktd,using-lsb;
                ktd,pwm-frequency = <1>; /* 1MHZ */
                ktd,bl-fscal-led = <0xF1>; /* 29mA */
                ktd,turn-on-ramp = <0x00>;
                ktd,turn-off-ramp = <0x04>;
                ktd,pwm-trans-dim = <0>;
                ktd,i2c-trans-dim = <128>;
                ktd,skip-first-trans;
                ktd,reset-trans-delay;
                ktd,bl-channel = <3>;
                ktd,ovp-level = <32>;  /*25.9v or 32v */
                ktd,ocp-level = <2600>;
                ktd,switching-frequency = <1>;
                ktd,inductor-current = <1>;
                ktd,default-brightness = <1251>;
                ktd,map-type = <0>; /* 0 exponential, 1 linear */
                ktd,current-align-type = <0x03>;  /* 0-none,  1-450nit,  2-1000nit,  3-gamma1.5 1000nit */
	};
};

&qupv3_se2_i2c_sleep {
    config {
        /delete-property/ bias-disable;
        bias-pull-up;
        input-enable;
    };
};

&qupv3_se9_spi {
	chipone_tddi@0{
		panel = <&mot_boe_icnl9922c_672_1080x2400_dsc_vid_120hz
			 &mot_csot_icnl9922c_672_1080x2400_dsc_vid_120hz>;
	};
	ilitek@1{
		panel = <&mot_txd_ili7807s_672_1080x2400_dsc_vid_120hz>;
	};
};
