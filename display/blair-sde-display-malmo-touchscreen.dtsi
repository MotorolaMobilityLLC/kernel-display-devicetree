&qupv3_se0_spi {
	#address-cells = <1>;
	#size-cells = <0>;

	status = "ok";

	//pinctrl-0 = <&qupv3_se0_spi_active &qupv3_se0_spi_cs_active>;
	//pinctrl-1 = <&qupv3_se0_spi_sleep &qupv3_se0_spi_cs_sleep>;

	goodix-berlin@0 {
		status = "ok";
		compatible = "goodix,gt9916S";
		reg = <0x0>;
		spi-max-frequency = <9600000>;

		panel = <&mot_csot_vtdr6115_gt9916_667_1080x2400_dsc_vid &mot_tm_vtdr6115_gt9916_667_1080x2400_dsc_vid>;
		mmi,status = "/chosen","mmi,panel_name","contains","gt9916";
		//goodix,avdd-name = "avdd";
		goodix,avdd-gpio = <&tlmm 84 0x0>;

		goodix,reset-gpio = <&tlmm 21 0x0>;
		goodix,irq-gpio = <&tlmm 22 0x0>;
		goodix,irq-flags = <2>;
		goodix,panel-max-x = <17280>;
		goodix,panel-max-y = <38400>;
		goodix,panel-max-w = <255>;
		goodix,panel-max-p = <4096>;

		pinctrl-names = "touch_ts_active_mux", "pmx_ts_suspend", "touch_ts_release_mux";
		pinctrl-0 = <&touch_ts_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend &ts_avdd_suspend>;
		pinctrl-2 = <&touch_ts_release>;

		//goodix,firmware-name = "goodix_firmware.bin";
		//goodix,config-name = "goodix_cfg_group.bin";
		//goodix,edge-ctrl;
		//goodix,interpolation-ctrl;
		//goodix,sample-ctrl;
		goodix,gesture-wait-pm;
		//mmi,power-off-suspend;
		mmi,usb-charger-detection;
		mmi,enable-gestures;
		mmi,supported_gesture_type = <0x07>;
	};

