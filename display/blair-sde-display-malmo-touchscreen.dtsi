&qupv3_se0_i2c {
	status = "disabled";
};

&tlmm {
	touch_ts_active_mux {
		touch_ts_active: touch_ts_active {
			mux {
				pins = "gpio21", "gpio22", "gpio84";
				function = "gpio";
			};

			config {
				pins = "gpio21", "gpio22", "gpio84";
				drive-strength = <8>;
				bias-pull-up;
			};
		};
	};

	pmx_ts_avdd_suspend {
		ts_avdd_suspend: ts_avdd_suspend {
			mux {
				pins = "gpio84";
				function = "gpio";
			};

			config {
				pins = "gpio84";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
	};

	touch_ts_release_mux {
		touch_ts_release: touch_ts_release {
			mux {
				pins = "gpio21", "gpio22", "gpio84";
				function = "gpio";
			};

			config {
				pins = "gpio21", "gpio22", "gpio84";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};
};

