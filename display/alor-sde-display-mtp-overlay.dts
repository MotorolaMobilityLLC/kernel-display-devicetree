/dts-v1/;
/plugin/;

#include "alor-sde-display-mtp.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Canoe MTP + ST54L + Kundu";
	compatible = "qcom,alor-mtp", "qcom,alor", "qcom,mtp";
	qcom,msm-id = <685 0x10000>;
	qcom,board-id = <0x10008 0>, <0x20008 0>, <0x30008 0>;
};
