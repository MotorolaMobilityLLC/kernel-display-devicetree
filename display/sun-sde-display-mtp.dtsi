			&dsi_nt37801_amoled_qsync_video
			&dsi_nt37801_amoled_fhd_plus_cmd
			&dsi_nt37801_amoled_cmd_ddicspr
			&dsi_nt37801_amoled_video_ddicspr
			&mot_csot_nt37707_667_1080x2640_dsc_cmd_v1>;
	};
};

